# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do

  # Change this to match your app's key and issuer
  before_all do |lane, options|
    app_store_connect_api_key(
      key_id: '4H27D3QLG2',
      issuer_id: 'ec2c19af-8deb-4579-be01-5d677995d709',
      key_filepath: './AuthKey.p8'
    )
    setup_ci if ENV['CI']
  end

  lane :versioning do
    tag = last_git_tag(pattern: 'v[0-9].*')
    increment_version_number(
    version_number: tag[1..-1] # Set a specific version number
    )
    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: 'Runner.xcodeproj'
    )
  end

  lane :build do
    match(type: 'appstore', readonly: is_ci)
    build_ios_app(
        export_method: 'app-store',
    )
  end

  lane :upload_testflight do
    release_notes = ENV['RELEASE_NOTES']
    upload_to_testflight(
      ipa: 'Runner.ipa',
      ## You can set this to true and remove the changelog if you want to save build processing time but not have change notes.
      skip_waiting_for_build_processing: false,
      #      distribute_external: true,
      # groups: ['external_testers],
      reject_build_waiting_for_review: true,
      wait_processing_interval: 15,
      # notify_external_testers: true,
      changelog: release_notes,
      )
  end

  lane :upload_metadata_app_store do
    upload_to_app_store(
        overwrite_screenshots: true,
        force: true,
        skip_binary_upload: true,
        precheck_include_in_app_purchases: false,
    )
  end

  lane :register do
    register_devices(devices_file: './fastlane/devices.txt')
    match(type: 'appstore', readonly: false)
    match(type: 'development', force_for_new_devices: true, readonly: false)
  end

end
